# Modified for JustFit: product identity and integration.
# Source from the candidate source directory after building both libraries.
# Explicit research configuration; no installed service is changed.
export JUSTFIT_PREFILL_ALIAS=1
export JUSTFIT_STAGED_PREFILL=1
export JUSTFIT_ROTATED_VERIFY=1
export JUSTFIT_PREFILL_A8=1
export JUSTFIT_VERIFY_A8=1
export JUSTFIT_VISION_PHASE=1
export JUSTFIT_COMPACT_SOFTMAX=1
export JUSTFIT_VERIFY_COALESCED=1
export JUSTFIT_LOOKUP=1
export JUSTFIT_VERIFY16_LIBRARY="$PWD/build/justfit-verify16.metallib"
# Optional diagnostic logging, disabled for measured runs:
# export JUSTFIT_LOOKUP_TRACE=1
