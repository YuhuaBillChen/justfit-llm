{
  "node": "m4",
  "environment": {
    "JUSTFIT_PREFILL_ALIAS": "1",
    "JUSTFIT_STAGED_PREFILL": "1",
    "JUSTFIT_ROTATED_VERIFY": "1",
    "JUSTFIT_PREFILL_A8": "0",
    "JUSTFIT_VERIFY_A8": "0",
    "JUSTFIT_VISION_PHASE": "1",
    "JUSTFIT_COMPACT_SOFTMAX": "1",
    "JUSTFIT_VERIFY_COALESCED": "1",
    "JUSTFIT_LOOKUP": "0",
    "JUSTFIT_HOST_EMBEDDING": "1",
    "JUSTFIT_ELASTIC_PREFILL": "1",
    "JUSTFIT_ANE_PHASE": "0",
    "JUSTFIT_LAYERED_PREFILL": "1",
    "JUSTFIT_DECODE_CHECKPOINT": "128",
    "JUSTFIT_CPU_PREFILL": "1",
    "JUSTFIT_CPU_TRACE": "1",
    "JUSTFIT_CPU_FRACTION": ".16",
    "JUSTFIT_CPU_THREADS": "8",
    "JUSTFIT_DYNAMIC_STAGING": "1",
    "JUSTFIT_PREFILL_PHASE_REUSE": "1",
    "JUSTFIT_TRIM_PREFILL_STATE_POOL": "1",
    "JUSTFIT_TRIM_DECODE_STATE_POOL": "1",
    "JUSTFIT_ANE_SINGLE_WEIGHTS": "0",
    "JUSTFIT_ANE_VISION_FAST_ADMISSION": "1",
    "JUSTFIT_ANE_VISION_PRIORITY": "1",
    "JUSTFIT_ANE_VISION_SCHEDULING": "0",
    "JUSTFIT_Q4_SHARED_APPLE10_EXPERIMENT": "0",
    "JUSTFIT_CPU_GROUP64": "1",
    "JUSTFIT_Q4_SHARED_LANES": "0",
    "JUSTFIT_CPU_GROUP64_WEIGHTED": "0",
    "JUSTFIT_CPU_DIRECT_ZA": "1",
    "JUSTFIT_CPU_VECTOR_PANEL": "1",
    "JUSTFIT_CPU_GPU_FUSION_ORDER": "1",
    "JUSTFIT_CPU_GPU_SUM_ORDER": "1",
    "JUSTFIT_CPU_GPU_UP_EPILOGUE": "1",
    "JUSTFIT_DISABLE_PREFIX_REUSE": "0"
  },
  "command": [
    "{release}/venv/bin/python",
    "-u",
    "-m",
    "server.server",
    "{model}",
    "--tokenizer",
    "{model}/tokenizer",
    "--model",
    "incoai/Qwen3.8-27B-Splash",
    "--binary",
    "{release}/source/build/justfit-engine",
    "--host",
    "127.0.0.1",
    "--port",
    "{port}",
    "--max-memory",
    "22015M",
    "--host-reserve",
    "128M",
    "--kv-format",
    "tq4",
    "--disable-ane",
    "--persistent-cache",
    "--max-cache-disk",
    "128G",
    "--cache-dir",
    "{cache}",
    "--request-timeout",
    "7200",
    "--no-webui"
  ],
  "vision_phase_qualification": {
    "prefill": true,
    "decode": true
  },
  "note": "Reference preset; historical PYTHONPATH removed in favor of pinned dependencies; assets and runtime state are provisioned locally."
}
